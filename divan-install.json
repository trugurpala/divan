{
  "schema_version": 1,
  "product": "Divan",
  "repository": "trugurpala/divan",
  "supported_hosts": [
    "claude",
    "codex"
  ],
  "installation": {
    "default_profile": "native",
    "codex_auto_profile": "auto",
    "fallback_profile": "verified-skill-fallback",
    "unrelated_extensions": "preserve"
  },
  "release_policy": {
    "source": "https://github.com/trugurpala/divan.git",
    "resolve": "latest-immutable-github-release",
    "exclude_draft": true,
    "exclude_prerelease": true,
    "require_tag": true,
    "forbidden_refs": [
      "main",
      "master",
      "latest"
    ],
    "require_sha256": true,
    "require_source_ref": true,
    "require_source_commit": true
  },
  "commands": {
    "preview": "python divan.pyz install --host {host} --profile {profile}",
    "execute": "python divan.pyz install --host {host} --profile {profile} --execute",
    "doctor": "python divan.pyz doctor --host {host} --json",
    "recovery": "{recovery_command}"
  },
  "success_marker": {
    "status": "verified",
    "doctor_status": "healthy",
    "ready": true,
    "restart_required": true
  },
  "result_fields": [
    "status",
    "version",
    "source_ref",
    "source_commit",
    "host",
    "profile",
    "package_count",
    "skill_count",
    "doctor_status",
    "restart_required",
    "next_action",
    "recovery_command"
  ],
  "daily_use": {
    "interface": "natural-language",
    "restart_instruction": "Close the desktop host completely and open a new session after installation.",
    "example": "Divan, bu işi devral. Önce durumu doğrula, uygula, test et ve kanıtı göster."
  }
}
