{
  "schema_version": 1,
  "effect_edges": {
    "catalog": ["documentation"],
    "documentation": ["public-site", "wiki"],
    "evaluation": ["release-validation"],
    "marketplace-validation": ["release-validation"],
    "public-site": ["release-validation"],
    "wiki": ["release-validation"],
    "company-validation": ["documentation"],
    "planning-validation": ["company-validation"],
    "local-ui": ["release-validation"],
    "security": ["release-validation"]
  },
  "effect_checks": {
    "catalog": ["python scripts/catalog.py --check"],
    "evaluation": ["python evals/run.py --check"],
    "marketplace-validation": ["python scripts/validate.py"],
    "wiki": ["python scripts/wiki.py --check"],
    "public-site": ["python -m unittest tests.test_site_markup -v"],
    "release-validation": ["python scripts/release.py --check"],
    "accessibility": ["python -m unittest tests.test_site_markup -v"],
    "browser-testing": ["browser verification"],
    "company-validation": ["python scripts/divan.py validate"],
    "planning-validation": [
      "python -m unittest tests.test_planning_intelligence -v"
    ],
    "local-ui": ["python -m unittest tests.test_seyir_ui -v"],
    "security": ["python -m unittest tests.test_local_server -v"]
  },
  "rules": [
    {
      "id": "skill-contract",
      "patterns": ["plugins/*/skills/*/SKILL.md", "plugins/*/skills/*/references/*.md"],
      "effects": ["catalog", "evaluation", "marketplace-validation"],
      "checks": ["python scripts/validate.py"]
    },
    {
      "id": "plugin-inventory",
      "patterns": ["plugins/*/.claude-plugin/plugin.json", "plugins/*/.codex-plugin/plugin.json", ".agents/plugins/marketplace.json", ".claude-plugin/marketplace.json"],
      "effects": ["catalog", "marketplace-validation"],
      "checks": ["python scripts/validate.py"]
    },
    {
      "id": "company-contract",
      "patterns": [
        "plugins/sadrazam/divan_runtime/*.json",
        "plugins/sadrazam/divan_runtime/*.py",
        "plugins/sadrazam/company/*.json",
        "plugins/sadrazam/company/*.py"
      ],
      "effects": ["company-validation"],
      "checks": ["python -m unittest tests.test_company_engine -v"]
    },
    {
      "id": "planning-intelligence",
      "patterns": [
        "plugins/sadrazam/divan_runtime/planning.py",
        "plugins/sadrazam/divan_runtime/planning_policy.py",
        "plugins/sadrazam/divan_runtime/engine.py",
        "plugins/sadrazam/divan_runtime/cli.py",
        "plugins/sadrazam/divan_runtime/cli_parser.py",
        "plugins/sadrazam/divan_runtime/goals.py",
        "plugins/sadrazam/divan_runtime/receipts.py",
        "plugins/sadrazam/divan_runtime/providers.py",
        "plugins/sadrazam/divan_runtime/modules.json",
        "plugins/sadrazam/company/planning.py",
        "plugins/sadrazam/company/planning_policy.py",
        "plugins/sadrazam/company/engine.py",
        "plugins/sadrazam/company/cli.py",
        "plugins/sadrazam/company/cli_parser.py",
        "plugins/sadrazam/company/goals.py",
        "plugins/sadrazam/company/receipts.py",
        "plugins/sadrazam/company/providers.py",
        "plugins/sadrazam/company/modules.json"
      ],
      "effects": ["planning-validation"],
      "checks": [
        "python -m unittest tests.test_planning_intelligence -v"
      ]
    },
    {
      "id": "portable-action",
      "patterns": [
        "plugins/sadrazam/divan_runtime/portable_actions.py",
        "plugins/sadrazam/divan_runtime/actions/*.py",
        "plugins/sadrazam/divan_runtime/portable-actions/*.json",
        "plugins/sadrazam/company/portable_actions.py",
        "plugins/sadrazam/company/actions/*.py",
        "plugins/sadrazam/company/portable-actions/*.json"
      ],
      "effects": ["company-validation", "release-validation"],
      "checks": ["python -m unittest tests.test_company_engine -v"]
    },
    {
      "id": "project-os-controller",
      "patterns": [
        "scripts/project_os*.py",
        "plugins/sadrazam/divan_runtime/controller*.py",
        "plugins/sadrazam/company/controller*.py"
      ],
      "effects": ["company-validation", "release-validation"],
      "checks": ["python scripts/divan.py validate"]
    },
    {
      "id": "project-os-state",
      "patterns": [".divan/*.json", ".divan/**/*.json", ".divan/*.jsonl", ".divan/**/*.jsonl"],
      "effects": ["company-validation"],
      "checks": ["python scripts/divan.py validate"]
    },
    {
      "id": "adoption-drift-lifecycle",
      "patterns": [
        "plugins/sadrazam/divan_runtime/project_lifecycle.py",
        "plugins/sadrazam/divan_runtime/project_state.py",
        "plugins/sadrazam/divan_runtime/project_transactions.py",
        "plugins/sadrazam/divan_runtime/goal_archive.py",
        "plugins/sadrazam/divan_runtime/adoption_common.py",
        "plugins/sadrazam/divan_runtime/adoption_legacy.py",
        "plugins/sadrazam/divan_runtime/adoption_schema2.py",
        "plugins/sadrazam/divan_runtime/adoption_runner.py",
        "plugins/sadrazam/divan_runtime/adoption.py",
        "plugins/sadrazam/divan_runtime/adoption_proof_common.py",
        "plugins/sadrazam/divan_runtime/adoption_proof_execution.py",
        "plugins/sadrazam/divan_runtime/adoption_proof.py",
        "plugins/sadrazam/company/project_lifecycle.py",
        "plugins/sadrazam/company/project_state.py",
        "plugins/sadrazam/company/project_transactions.py",
        "plugins/sadrazam/company/goal_archive.py",
        "plugins/sadrazam/company/adoption.py",
        ".divan/install-state.json",
        ".divan/archive/**",
        ".divan/evidence/*/adoption-receipt.*",
        ".divan/evidence/verified-clean-room-adoption-*.json",
        "registry/v1-gates.json",
        ".github/ISSUE_TEMPLATE/kabul-kaniti.yml",
        "canary/**"
      ],
      "effects": ["company-validation", "documentation", "release-validation"],
      "checks": [
        "python -m unittest tests.test_adoption tests.test_adoption_v2 tests.test_adoption_proof tests.test_v1 -v",
        "python scripts/release.py --check"
      ]
    },
    {
      "id": "user-interface",
      "patterns": ["site/*.html", "site/robots.txt", "site/sitemap.xml", "docs/index.html", "docs/robots.txt", "docs/sitemap.xml"],
      "effects": ["accessibility", "browser-testing", "public-site"],
      "checks": []
    },
    {
      "id": "local-seyir",
      "patterns": [
        "plugins/sadrazam/divan_runtime/locales.py",
        "plugins/sadrazam/divan_runtime/messages.json",
        "plugins/sadrazam/divan_runtime/seyir_state.py",
        "plugins/sadrazam/divan_runtime/status.py",
        "plugins/sadrazam/divan_runtime/local_server.py",
        "plugins/sadrazam/divan_runtime/studio/*"
      ],
      "effects": ["company-validation", "local-ui", "security"],
      "checks": [
        "python -m unittest tests.test_locales tests.test_seyir_state tests.test_status_snapshot tests.test_local_server tests.test_seyir_ui -v"
      ]
    },
    {
      "id": "documentation-source",
      "patterns": ["README*.md", "docs/*.md", "CONTRIBUTING*.md"],
      "effects": ["documentation"],
      "checks": []
    },
    {
      "id": "project-memory",
      "patterns": ["AGENTS.md", "CLAUDE.md", "BLUEPRINT.md", ".divan/*.md", ".divan/**/*.md"],
      "effects": ["company-validation", "documentation", "release-validation"],
      "checks": ["python scripts/handoff.py --check"]
    },
    {
      "id": "release-contract",
      "patterns": ["VERSION", "CHANGELOG.md", "release-manifest.json", "scripts/release.py"],
      "effects": ["release-validation", "public-site", "wiki"],
      "checks": []
    },
    {
      "id": "quality-controller",
      "patterns": ["scripts/validate.py", "scripts/standards.py", "scripts/naming.py", "scripts/clean_code.py", "registry/*.json"],
      "effects": ["company-validation", "release-validation"],
      "checks": ["python scripts/validate.py", "python scripts/clean_code.py --check"]
    },
    {
      "id": "host-lifecycle",
      "patterns": ["scripts/divan.py", "scripts/host_*.py", "scripts/install_codex.*", "scripts/uninstall_codex.*"],
      "effects": ["marketplace-validation", "release-validation"],
      "checks": ["python -m unittest tests.test_host_install tests.test_host_upgrade -v"]
    },
    {
      "id": "continuous-integration",
      "patterns": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
      "effects": ["release-validation"],
      "checks": ["actionlint", "python -m unittest tests.test_workflows -v"]
    },
    {
      "id": "test-contract",
      "patterns": ["tests/test_*.py", "tests/fixtures/**"],
      "effects": ["release-validation"],
      "checks": ["python -m unittest discover -s tests -v"]
    },
    {
      "id": "repository-controller",
      "patterns": ["scripts/*.py"],
      "effects": ["release-validation"],
      "checks": ["python scripts/validate.py"]
    },
    {
      "id": "installed-command",
      "patterns": ["plugins/*/commands/*.md"],
      "effects": ["documentation", "marketplace-validation"],
      "checks": ["python scripts/validate.py"]
    }
  ]
}
