{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divan",
  "version": "1.3.8",
  "mainBinaryName": "Divan",
  "identifier": "com.ugurpala.divan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Divan — AI Yazılım Kumanda Merkezi",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "AI yazılım ekipleri için masaüstü kontrol merkezi",
    "longDescription": "Divan; görev, execution engine, kanıt, review ve release kapılarını tek masaüstü uygulamasında yönetir.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"]
      }
    }
  }
}
