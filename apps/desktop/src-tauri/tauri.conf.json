{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Divan",
  "version": "0.1.0",
  "identifier": "com.trugurpala.divan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DİVAN — AI Yazılım Kumanda Merkezi",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/divan-generated.ico"],
    "resources": ["resources/*"]
  }
}
